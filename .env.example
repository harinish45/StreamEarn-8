# StreamEarn Environment Variables Example
# Duplicate this file as .env.local for local development. Do not commit actual secrets.

# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:9002
NODE_ENV=development

# WebRTC & Live Streaming Ingestion
NEXT_PUBLIC_WEBRTC_INGEST_URL=webrtc://live.streamearn.ai/live
NEXT_PUBLIC_STREAM_CDN_URL=https://stream.streamearn.ai/hls

# Stripe Monetization (Tipping & Subscriptions)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_placeholder
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock_publishable_key_placeholder

# Supabase Database & Auth (Optional)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...example_anon_key

# Model Context Protocol / AI Integrations (Optional)
MCP_SERVER_PORT=3001
AI_DISCOVERY_API_KEY=mock_ai_key_placeholder
